{
  "name": "masterme-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "bun test",
    "lint": "next lint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@vinext/cloudflare": "^1.0.0-beta.10",
    "next": "16.1.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.2",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  },
  "type": "module"
}
