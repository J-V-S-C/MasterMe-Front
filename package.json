{
  "name": "masterme-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "bun test",
    "validate": "bun run typecheck && bun test && bun run build && bun run build:vinext",
    "validate:dependencies": "bun audit --production",
    "validate:guardrails": "bun test scripts/quality-guardrails.test.ts",
    "lint": "next lint",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vinext/cloudflare": "^1.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.35",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.3",
    "vinext": "^1.0.1",
    "vite": "^8.3.3",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "fflate": "^0.7.5",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2"
  },
  "type": "module"
}
